{
  "name": "@tgit/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "prisma:generate": "node ../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ../node_modules/prisma/build/index.js migrate deploy",
    "prisma:validate": "node ../node_modules/prisma/build/index.js validate"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^3.24.2",
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
