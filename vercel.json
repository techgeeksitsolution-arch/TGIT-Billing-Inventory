{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node node_modules/prisma/build/index.js generate && node node_modules/vite/bin/vite.js build --config frontend/vite.config.js",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
