{
  "name": "tgit-billing-inventory",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"node backend/src/server.js\" \"node node_modules/vite/bin/vite.js --config frontend/vite.config.js\"",
    "build": "node node_modules/vite/bin/vite.js build --config frontend/vite.config.js",
    "start": "node backend/src/server.js",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "check": "node --check backend/src/server.js && node --check backend/src/app.js && node node_modules/vite/bin/vite.js build --config frontend/vite.config.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true
  }
}
